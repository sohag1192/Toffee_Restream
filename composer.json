{
    "name": "sohag1192/toffee-restream",
    "description": "Toffee Live TV Restream & Modern Web Player (Pure PHP)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "files": [
            "src/playlist_manager.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "lint": [
            "php -l index.php",
            "php -l src/playlist_manager.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
